    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }

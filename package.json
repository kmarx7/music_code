{
  "name": "music-score-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "perf:browser": "playwright test --config playwright.perf.config.ts",
    "perf:pitch": "vitest run --config vitest.perf.config.ts",
    "eval:humming": "node scripts/eval-humming.mjs",
    "check:architecture": "depcruise src --config .dependency-cruiser.cjs && node scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tone": "^15.1.22",
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
